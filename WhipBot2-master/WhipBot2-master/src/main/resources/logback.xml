<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%-25logger{25}] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Bot logs : INFO et plus -->
    <logger name="fr.whip.bot" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- JDA : uniquement WARN (cache le flood websocket/heartbeat) -->
    <logger name="net.dv8tion.jda" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Hibernate : uniquement WARN (cache les requêtes SQL) -->
    <logger name="org.hibernate" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- HikariCP : uniquement WARN -->
    <logger name="com.zaxxer.hikari" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Javalin / Jetty : uniquement WARN -->
    <logger name="io.javalin" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="org.eclipse.jetty" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Netty : uniquement ERROR -->
    <logger name="io.netty" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Tout le reste : WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
