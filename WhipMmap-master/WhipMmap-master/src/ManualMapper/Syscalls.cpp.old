#include "ManualMapper/SyscallsAdapter.h"
#include <winternl.h>

namespace ManualMapper
{
    static BYTE* g_syscallStub = nullptr;

    WORD Syscalls::GetSyscallNumber(const char* functionName)
    {
        HMODULE ntdll = GetModuleHandleA("ntdll.dll");
        if (!ntdll)
            return 0;

        BYTE* functionAddress = reinterpret_cast<BYTE*>(GetProcAddress(ntdll, functionName));
        if (!functionAddress)
            return 0;

        if (functionAddress[0] == 0x4C && functionAddress[1] == 0x8B && functionAddress[2] == 0xD1 &&
            functionAddress[3] == 0xB8)
        {
            return *reinterpret_cast<WORD*>(functionAddress + 4);
        }

        if (functionAddress[0] == 0xB8)
        {
            return *reinterpret_cast<WORD*>(functionAddress + 1);
        }

        for (int i = 0; i < 32; i++)
        {
            if (functionAddress[i] == 0xB8 && functionAddress[i + 5] == 0x00 && functionAddress[i + 6] == 0x00)
            {
                return *reinterpret_cast<WORD*>(functionAddress + i + 1);
            }
        }

        return 0;
    }

    bool Syscalls::Initialize()
    {
        if (g_syscallStub)
            return true;

        BYTE stubCode[] = {
            0x4C, 0x8B, 0xD1,
            0xB8, 0x00, 0x00, 0x00, 0x00,
            0x0F, 0x05,
            0xC3
        };

        g_syscallStub = reinterpret_cast<BYTE*>(VirtualAlloc(nullptr, sizeof(stubCode), MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
        if (!g_syscallStub)
            return false;

        memcpy(g_syscallStub, stubCode, sizeof(stubCode));
        return true;
    }

    typedef NTSTATUS(NTAPI* SyscallFunction)(...);

    NTSTATUS Syscalls::NtAllocateVirtualMemory(
        HANDLE ProcessHandle,
        PVOID* BaseAddress,
        ULONG_PTR ZeroBits,
        PSIZE_T RegionSize,
        ULONG AllocationType,
        ULONG Protect
    )
    {
        static WORD syscallNumber = GetSyscallNumber("NtAllocateVirtualMemory");

        if (!g_syscallStub)
            Initialize();

        *reinterpret_cast<DWORD*>(g_syscallStub + 4) = syscallNumber;

        auto func = reinterpret_cast<SyscallFunction>(g_syscallStub);
        return func(ProcessHandle, BaseAddress, ZeroBits, RegionSize, AllocationType, Protect);
    }

